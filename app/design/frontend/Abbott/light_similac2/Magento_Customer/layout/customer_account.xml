        <title>My Account</title>
        <css src="css/my_account/myaccount.css" media="all" />
    </head>
	 <body>
	 <referenceContainer name="main">
		<block class="Magento\Framework\View\Element\Template" name="aem_recently_ordered" after="-" template="Magento_Customer::order/recentOrders.phtml" />
