        <referenceBlock name="sidebar.main.account_nav">
		  <action method="setTemplate">
              <argument name="template" xsi:type="string">Magento_Theme::header/similac_left_nav.phtml</argument>
		  </action>
      </referenceBlock>
    </body>
</page>
