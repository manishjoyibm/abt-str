<?xml version="1.0" encoding="UTF-8"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <remove src="css/abbottstore.css"/>
        <remove src="css/clientlib-base.css"/>
        <remove src="css/clientlib-abbottstore.js"/>
        <remove src="css/clientlib-base.js"/>
        <remove src="css/abbott-header.js"/>
	<css src="css/my_account/printinvoice.css" media="all" />
    </head>
    <body>
        <referenceBlock name="logo" remove="true"/>
        <referenceBlock name="cusotmheader" remove="true"/>
        <referenceBlock name="customfooter" remove="true"/>
        <referenceContainer name="content">
            <block class="Magento\Sales\Block\Order\PrintOrder\Invoice" name="sales.order.print.invoice" template="Magento_Sales::order/print/invoice.phtml">
                <block class="Magento\Framework\View\Element\RendererList" name="sales.order.print.invoice.renderers" as="renderer.list" />
                <block class="Magento\Sales\Block\Order\Invoice\Totals" name="invoice_totals" template="Magento_Sales::order/email_totals.phtml" cacheable="false">
                    <arguments>
                        <argument name="label_properties" xsi:type="string">colspan="4" class="mark"</argument>
                        <argument name="value_properties" xsi:type="string">class="amount"</argument>
                    </arguments>
                    <block class="Magento\Tax\Block\Sales\Order\Tax" name="tax" template="Magento_Tax::order/email_tax.phtml"/>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
