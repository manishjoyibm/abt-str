$helper = $this->helper('Abbott\MyAccount\Helper\Data');
if($helper->getGAreturnSession() == 1)
{    ?>
    <script>
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({event: "ga-custom-events",eventCategory: "return-item",eventAction: "submit",eventLabel: "return-item"});
    </script>
<?php
