                    </td>
                </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
    <?php if ($block->getPagerHtml()) : ?>
        <div class="order-products-toolbar toolbar bottom">
            <?= $block->getPagerHtml() ?>
        </div>
    <?php endif ?>
<?php else : ?>
    <div class="message info empty"><span><?= $block->escapeHtml(__('You have placed no returns.')) ?></span></div>
<?php endif ?>
<div class="processed_return_note"><strong>Need to return an item?</strong> Go to your <a onclick="orderReturn()" href="<?php echo $block->getBaseUrl() ?>sales/order/history">Orders</a>.</div>
