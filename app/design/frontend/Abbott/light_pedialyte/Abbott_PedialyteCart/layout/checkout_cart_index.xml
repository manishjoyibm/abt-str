<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Abbott_PedialyteCart::css/pediacart.css" />
    </head>
    <body>
        <referenceBlock name="checkout.cart.totals">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="block-totals" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="pdl_discount" xsi:type="array">
                                    <item name="component"  xsi:type="string">Abbott_PedialyteCart/js/view/checkout/cart/totals/discount</item>
                                    <item name="sortOrder" xsi:type="string">25</item>
                                    <item name="config" xsi:type="array">
                                        <item name="template" xsi:type="string">Abbott_PedialyteCart/checkout/cart/totals/discount</item>
                                        <item name="title" xsi:type="string" translate="true">Total Savings</item>
                                    </item>
                                </item>

                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
