<?php
/** @var $block \Magento\Rma\Block\Email\Items */
?>
<table class="email-items rma-items padding-left20">
    <thead>
    <tr>
        <th class="light-blue"><?= $block->escapeHtml(__('Product')) ?></th>
        <th class="light-blue"><?= $block->escapeHtml(__('SKU')) ?></th>
        <th class="light-blue"><?= $block->escapeHtml(__('Condition')) ?></th>
        <th class="light-blue"><?= $block->escapeHtml(__('Ordered Qty')) ?></th>
        <th class="light-blue"><?= $block->escapeHtml(__('Qty to return')) ?></th>
        <th class="light-blue"><?= $block->escapeHtml(__('Status')) ?></th>
    </tr>
    </thead>
    <tbody>
    <?php foreach ($block->getCollection() as $item) : ?>
    <tr>
        <td>
            <strong><?= $block->escapeHtml($item->getProductName()) ?></strong>
            <?php if ($_options = $item->getOptions()) : ?>
            <dl class="item-options">
                <?php foreach ($_options as $_option) : ?>
                <dt><?= $block->escapeHtml($_option['label']) ?></dt>
                <dd><?= $block->escapeHtml($_option['value']) ?></dd>
                <?php endforeach; ?>
            </dl>
            <?php endif; ?>
        </td>
        <td><?= $block->escapeHtml($item->getProductSku()) ?></td>
        <td><?= $block->escapeHtml($block->getOptionAttributeStringValue($item->getCondition())) ?></td>
        <td><?= $this->helper(Magento\Rma\Helper\Data::class)->parseQuantity($item->getQtyRequested(), $item) ?></td>
        <td><?= $this->helper(Magento\Rma\Helper\Data::class)->getQty($item) ?></td>
        <td><?= $block->escapeHtml($item->getStatusLabel()) ?></td>
    </tr>
    <?php endforeach; ?>
    </tbody>
</table>
