                            <span id="emailLabel">E-mail</span>
                        </div>
                        <div id="emailAnswerDiv" class="prefAnswer">
                            <?php if ($block->getIsSubscribed()) { ?>
                                <span id="emailAnswer"><?= $block->escapeHtml(__('Yes')) ?></span>
                            <?php } else { ?>
                                <span id="emailAnswer"><?= $block->escapeHtml(__('No')) ?></span>
