                <div class="ot-form-wrapper">
                    <iframe title="ot-iframe"
                        src="<?= $escaper->escapeUrl($viewModel->getPreferenceCenterUrl($block->getCustomer()->getEmail())) ?>">
                    </iframe>
                </div>
            <?php } else { ?>
                <legend class="legend"><span><?= $escaper->escapeHtml(__('Manage your contact preferences')) ?></span></legend><br>
                <div id="previousContent">
                    <div id="emailSection" class="prefSection">
