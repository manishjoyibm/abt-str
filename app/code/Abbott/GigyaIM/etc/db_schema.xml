<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ssm_shopping_cart">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" comment="Id" identity="true"/>
        <column xsi:type="varchar" name="email" nullable="false" length="255" comment="Customer email"/>
        <column xsi:type="int" name="website_id" padding="10" unsigned="true" nullable="false" comment="Website Id"/>
        <column xsi:type="varchar" name="masked_cart_id" nullable="false" length="255" comment="Masked Cart Id"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Update Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SSM_CUSTOMER_EMAIL_WEBSITE_ID">
            <column name="email"/>
            <column name="website_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SSM_MASKED_CART_ID">
            <column name="masked_cart_id"/>
        </constraint>
    </table>
</schema>