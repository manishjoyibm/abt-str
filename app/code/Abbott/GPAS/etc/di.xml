<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Abbott\GPAS\Api\QrCodeManagerInterface" type="Abbott\GPAS\Model\QrCodeManager"/>
    <preference for="Abbott\GPAS\Api\Data\Rest\ResponseInterface" type="Abbott\GPAS\Model\Rest\Response"/>
    <preference for="Abbott\GPAS\Api\QrCodeRepositoryInterface" type="Abbott\GPAS\Model\QrCodeRepository"/>
    <type name="Magento\Customer\Api\AccountManagementInterface">
        <plugin name="assign_qrcode_to_customer_plugin" type="Abbott\GPAS\Plugin\Model\AccountManagementPlugin" />
    </type>

    <!-- Disabled for ANAPOLLO-4691 -->
    <type name="Magento\Quote\Model\Quote">
        <plugin name="add_to_cart_plugin_gpas" type="Abbott\GPAS\Plugin\Model\QuotePlugin" disabled="true"/>
    </type>
    <type name="Magento\Sales\Model\Service\OrderService">
        <plugin name="place_order_plugin_gpas" type="Abbott\GPAS\Plugin\Model\OrderServicePlugin" />
    </type>
    <virtualType name="Abbott\GPAS\Logger\Method\System" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/gpas.log</argument>
        </arguments>
    </virtualType>
    <type name="Abbott\GPAS\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">GPAS_Log</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Abbott\GPAS\Logger\Method\System</item>
            </argument>
        </arguments>
    </type>
</config>
