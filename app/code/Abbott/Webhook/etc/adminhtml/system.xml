<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
      <tab id="abbott" sortOrder="20" translate="label">
  			<label>Abbott</label>
  		</tab>
      <section id="abbott_webhook" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
        <label>Webhook Integration</label>
  			<tab>abbott</tab>
        <resource>Magento_Config::config</resource>
        <group id="webhook"  showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Webhook Configuration Settings</label>
            <field id="enable" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Enable Webhook Feature</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            </field>
            <field id="enable_debug" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Enable Webhook Debug</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            </field>
            <field id="username" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="30" translate="label" type="text">
                <label>User Name</label>
            </field>
            <field id="password" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="40" translate="label" type="obscure">
                <label>Password</label>
                <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
            </field>
            <field id="flavorsize_url" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="50" translate="label" type="text">
  						<label>AEM Url to update flavors and size attributes, subscription plans</label>
  					</field>
            <field id="attribute_codes" type="textarea" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1" translate="label">
                <label>Attribute Codes of attributes to update in AEM</label>
                <comment>Please provide the values separeted by commas ex: flavors,size</comment>
            </field>
        </group>
      </section>
    </system>
</config>
