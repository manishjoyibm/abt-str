<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="sales_order" resource="sales" engine="innodb" comment="Sales Order">
        <column xsi:type="varchar" name="order_classification" nullable="true" length="50" comment="HH Order Classfication"/>
        <column xsi:type="boolean" name="is_rush_order" nullable="false" default="0" comment="HH Order Type"/>
    </table>
	
	<table name="abbott_order_classfication" resource="default" engine="innodb" comment="Order Classification">
        <column xsi:type="int" name="rule_id" padding="10" unsigned="true" identity="true" nullable="false" comment="rule id"/>
        <column xsi:type="varchar" length="255" name="name" nullable="true" comment="Rule Name"/>
        <column xsi:type="text" name="description" nullable="true" comment="Rule description"/>       
        <column xsi:type="varchar" length="100" name="rule_customer_group" nullable="true" comment="Rule customer group"/>
        <column xsi:type="varchar" length="100" name="rule_website_ids" nullable="true" comment="rule website ids"/>
        <column xsi:type="varchar" length="100" name="rule_order_attribute" nullable="true" comment="rule order attribute"/>
        <column xsi:type="varchar" length="100" name="order_classification" nullable="true" comment="rule order classification"/>
        <column xsi:type="date" name="from_date" nullable="false"  comment="From Date"/>
        <column xsi:type="date" name="to_date" nullable="false" comment="End Date"/>
	    <column xsi:type="boolean" name="is_active" nullable="true" comment="Is Active"/>
        <column xsi:type="text" name="conditions_serialized" nullable="true" comment="Rule conditions serialized"/>       
        <column xsi:type="int" name="sort_order" default="0" nullable="false" comment="Priority"/>
	    <column xsi:type="boolean" name="order_attr_type" nullable="true" comment="Order Attribute Input"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="rule_id"/>
        </constraint>
	</table>


</schema>