<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="aw_sarp2_subscription_history" resource="default" engine="innodb" comment="subscription_history table">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="false" nullable="false" identity="true" comment="Autoincrement ID"/>
        <column xsi:type="int" name="profile_id" unsigned="true" padding="10" comment="Profile Id"/>
        <column xsi:type="varchar" name="subscription_id" nullable="false"  length="255" comment="Subscription Id"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false"  identity="false" comment="Customer Id"/>
        <column xsi:type="smallint" name="store_id" unsigned="false" nullable="false"  identity="false" comment="Descrition"/>
        <column xsi:type="smallint" name="is_impersonate" unsigned="false" nullable="false"  identity="false" comment="Descrition"/>
        <column xsi:type="varchar" name="event_name" nullable="false" length="255" comment="Name of the event from which data is saved in table"/>
        <column xsi:type="varchar" name="mbo_user" nullable="false" length="255" comment="Name of the MBO user who has made changes"/>
        <column xsi:type="text" name="before_value" nullable="false" comment="Subscription data before event is triggered"/>
        <column xsi:type="text" name="after_value" nullable="false" comment="Subscription data after event is triggered"/>
        <column xsi:type="datetime" name="created_at"  on_update="false" default="CURRENT_TIMESTAMP" nullable="false" comment="Record created date"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="SUBSCRIPTION_HISTORY_PROFILE_ID" indexType="btree">
            <column name="profile_id"/>
        </index>
        <index referenceId="SUBSCRIPTION_HISTORY_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>
</schema>
