<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="checkout"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <script src="Abbott_OneTrust::js/set_consent.js"/>
    </head>
    <body>
        <referenceContainer name="page.wrapper">
            <container name="checkout.onetrustconsent" before="main.content">
                <block
                    class="Magento\Framework\View\Element\Template"
                    name="checkout_onetrustconsent"
                    template="Abbott_OneTrust::consent.phtml"
                    ifconfig="onetrust/general/enabled">
                    <arguments>
                        <argument name="ot_view_model" xsi:type="object">Abbott\OneTrust\ViewModel\OnetrustViewModel
                        </argument>
                    </arguments>
                </block>
            </container>
        </referenceContainer>
    </body>
</page>
