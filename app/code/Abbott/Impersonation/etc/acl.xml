<?xml version="1.0" encoding="UTF-8"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Customer::customer">
                    <resource id="Abbott_Impersonation::login" title="Login As Customer" sortOrder="50">
                        <resource id="Abbott_Impersonation::login_button" title="Login As Customer Button" sortOrder="10" />
                        <resource id="Abbott_Impersonation::login_log" title="Login As Customer Log" sortOrder="20" />
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
