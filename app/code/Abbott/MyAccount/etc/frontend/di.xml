<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\Customer\Block\Address\Grid" type="Abbott\MyAccount\Block\Address\Grid" />
    <preference for="Magento\Customer\Block\Form\Register" type="Abbott\MyAccount\Block\Form\Register" />
    <type name="Magento\Newsletter\Controller\Manage\Save">
        <plugin name="newslettersave" type="Abbott\MyAccount\Plugin\Controller\Manage\SavePlugin"/>
    </type>
    <type name="Magento\Customer\Controller\Account\Login">
        <plugin name="loginPlugin" type="Abbott\MyAccount\Plugin\Controller\Account\LoginPlugin" />
    </type>
     <type name="Magento\Customer\Controller\Account\Create">
        <plugin name="registrationPlugin" type="Abbott\MyAccount\Plugin\Controller\Account\CreatePlugin" />
    </type>
    <type name="Magento\Customer\Controller\Account\CreatePost">
        <plugin name="regipostPlugin" type="Abbott\MyAccount\Plugin\Controller\Account\CreatePostPlugin" />
    </type>
    <preference for="Magento\Rma\Block\Link" type="Abbott\MyAccount\Block\Link" />
    <type name="Magento\Customer\Controller\Plugin\Account">
        <arguments>
            <argument name="allowedActions" xsi:type="array">
                <item name="logout" xsi:type="string">logout</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Cms\Controller\Index\Index">
        <plugin name="cmsIndexPlugin" type="Abbott\MyAccount\Plugin\Controller\Cms\IndexPlugin" />
    </type>
    <type name="Magento\Catalog\Controller\Category\View">
        <plugin name="catViewPlugin" type="Abbott\MyAccount\Plugin\Controller\Catalog\Category\ViewPlugin" />
    </type>
    <type name="Magento\Catalog\Controller\Product\View">
        <plugin name="prodViewPlugin" type="Abbott\MyAccount\Plugin\Controller\Catalog\Product\ViewPlugin" />
    </type>
    <type name="Magento\Framework\View\Element\Html\Links">
        <plugin sortOrder="1" name="CustomerAccountLinksManagerLinks"
                type="Abbott\MyAccount\Plugin\View\Element\Html\LinksPlugin"/>
    </type>
    <type name="Magento\Customer\Controller\Account\Index">
        <plugin name="myaccountPlugin" type="Abbott\MyAccount\Plugin\Controller\Account\IndexPlugin" />
    </type>
    <type name="Magento\Customer\Controller\Account\ForgotPassword">
        <plugin name="forgotPlugin" type="Abbott\MyAccount\Plugin\Controller\Account\ForgotPasswordPlugin" />
    </type>
    <type name="Magento\Customer\Controller\Account\CreatePassword">
        <plugin name="createpwdPlugin" type="Abbott\MyAccount\Plugin\Controller\Account\CreatePasswordPlugin" />
    </type>
    <type name="Magento\Downloadable\Controller\Customer\Products">
        <plugin name="mydownloadablePlugin" type="Abbott\MyAccount\Plugin\Controller\Downloadable\Customer\ProductsPlugin" />
    </type>
   <type name="Magento\CustomerBalance\Controller\Info\Index">
        <plugin name="customerbalancePlugin" type="Abbott\MyAccount\Plugin\Controller\CustomerBalance\Info\IndexPlugin" />
   </type>
    <type name="Magento\GiftCardAccount\Controller\Customer\Index">
        <plugin name="giftcardPlugin" type="Abbott\MyAccount\Plugin\Controller\GiftCardAccount\Customer\IndexPlugin" />
    </type>
    <type name="Magento\Sales\Controller\Order\History">
        <plugin name="orderHistoryPlugin" type="Abbott\MyAccount\Plugin\Controller\Account\OrderHistoryPlugin" />
    </type>
    <type name="Aheadworks\Sarp2\Controller\Profile\Index">
        <plugin name="mySubscriptionPlugin" type="Abbott\MyAccount\Plugin\Controller\Account\MySubscriptionPlugin" />
    </type>
	<type name="Magento\CustomAttributeManagement\Block\Form">
        <plugin name="hideCustomAttributes" type="Abbott\MyAccount\Plugin\Block\CustomAttributeManagement\Form" />
    </type>
    <preference for="Magento\Customer\Controller\Account\Logout" type="Abbott\MyAccount\Controller\Account\Logout" />
    <preference for="Magento\Customer\Controller\Account\CreatePost" type="Abbott\MyAccount\Controller\Account\CreatePost" />
    <preference for="Magento\Customer\Controller\Account\ForgotPasswordPost" type="Abbott\MyAccount\Controller\Account\ForgotPasswordPost" />
    <preference for="Magento\Customer\Controller\Account\LoginPost" type="Abbott\MyAccount\Controller\Account\LoginPost" />
    <preference for="Magento\Customer\Controller\Ajax\Login" type="Abbott\MyAccount\Controller\Ajax\Login" />

    <preference for="Magento\Customer\Controller\Account\Confirm" type="Abbott\MyAccount\Controller\Account\Confirm" />
    <preference for="Magento\Cms\Controller\Noroute\Index" type="Abbott\MyAccount\Controller\Noroute\Index" />

    <type name="Magento\Customer\Model\CustomerExtractor">
        <plugin name="Abbott_MyAccount_Model_CustomerExtractor_Around_Plugin" type="Abbott\MyAccount\Plugin\Model\CustomerExtractor" sortOrder="10" disabled="false"  />
    </type>
    <type name="Magento\Customer\Controller\Address\FormPost">
	<plugin name="addressSavePlugun" type="Abbott\MyAccount\Plugin\Controller\Address\FormPostPlugin" />
    </type>
</config>
