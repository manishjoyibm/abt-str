<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="abbott" translate="label" sortOrder="10">
            <label>Abbott</label>
        </tab>
        <section id="abbott_csp" translate="label" sortOrder="132" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>CSP Whitelist</label>
            <tab>abbott</tab>
            <resource>Abbott_Configuration::Custom_configuration</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Configuration</label>
                <field id="info" translate="label comment" type="label" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Important Information</label>
                    <comment><![CDATA[<strong class="colorRed" style="font-size:13px;">When adding or changing whitelist, ensure to include
                        only those domains that are recognised and
                        trustworthy. This precaution is crucial because
                        unauthorised or compromised domains may contain
                        malicious scripts.</strong>]]></comment>
                </field>
                <field id="enabled" translate="label comment" type="select" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Module Enabled</label>
                    <comment>This setting will be used to enable or disable module</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="report_only" translate="label comment" type="select" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Report Only Mode</label>
                    <comment><![CDATA[This setting will be used to switch CSP mode <br/>
                        YES - Report Only (Only report potential vulnerability) <br/>
                        NO - Strict Mode (Refuse to execute code or load data to prevent vulnerability)]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <backend_model>Abbott\Csp\Model\Config\Backend\ReportOnly</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="report_collection" translate="label comment" type="select" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Report Collection Enabled</label>
                    <comment>Enable this setting to collect CSP reports</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
