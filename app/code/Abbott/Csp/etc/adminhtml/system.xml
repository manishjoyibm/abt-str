                <field id="whitelist_entries" translate="label comment" type="select" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Whitelist entries</label>
                    <comment><![CDATA[Please add URLs that you want to whitelist]]></comment>
