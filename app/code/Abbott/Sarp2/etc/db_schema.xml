<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="aw_sarp2_profile" resource="default" engine="innodb">
        <column xsi:type="varchar" name="delivery_instruction" length="255" nullable="true"
                comment="Delivery Instruction"/>
    </table>

    <table name="aw_sarp2_profile_payment_change_log" resource="default" engine="innodb">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" identity="true" nullable="false" comment="Id"/>
        <column xsi:type="int" name="profile_id" padding="10" unsigned="true" nullable="false" comment="Profile Id"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer Id"/>
        <column xsi:type="text" name="token" nullable="true" comment="Payment Token"/>
        <column xsi:type="datetime" name="created_at" nullable="true" comment="Created At"/>
        <column xsi:type="boolean" name="has_failed" nullable="false" default="false" comment="Payment Has Failed"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>

    <table name="aw_sarp2_plan_title" resource="default" engine="innodb">
    <column xsi:type="int" name="id" padding="10" unsigned="true" identity="true" nullable="false" comment="Id"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>

    <table name="aw_sarp2_core_notification">
        <column xsi:type="varchar" name="status" length="32" nullable="true"
                comment="Notification Status"/>
        <column xsi:type="timestamp" name="scheduled_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Scheduled At"/>
        <index referenceId="AW_SARP2_CORE_NOTIFICATION_STATUS_INDEX" indexType="btree">
            <column name="status"/>
            <column name="scheduled_at"/>
        </index>
    </table>
    <table name="aw_sarp2_core_schedule_item">
        <column xsi:type="varchar" name="type" length="32" nullable="true"
                comment="Schedule Item Type"/>
        <column xsi:type="varchar" name="payment_status" length="32" nullable="true"
                comment="Payment Status"/>
        <column xsi:type="timestamp" name="retry_at" on_update="false" nullable="true" default="NULL"
                comment="Retry At"/>
        <index referenceId="AW_SARP2_CORE_SCHEDULE_PAYMENT_TYPE_STATUS_RTRY_INDEX" indexType="btree">
            <column name="type"/>
            <column name="payment_status"/>
            <column name="retry_at"/>
        </index>
    </table>
    <table name="aw_sarp2_payment_token">
        <column xsi:type="varchar" name="payment_method" length="128" nullable="false" comment="Payment Method Code"/>
        <column xsi:type="varchar" name="type" length="128" nullable="false" comment="Token Type"/>
        <column xsi:type="varchar" name="token_value" length="255" nullable="false" comment="Token Value"/>
        <index referenceId="AW_SARP2_PAYMENT_METHOD_TYPE_VALUE_INDEX" indexType="btree">
            <column name="payment_method"/>
            <column name="type"/>
            <column name="token_value"/>
        </index>
    </table>

    <table name="abbott_sarp2_annual_reminder" resource="default" engine="innodb" comment="Abbott SARP2 Annual Reminder Sent">
        <column xsi:type="int" name="entity_id" nullable="false" identity="true" unsigned="true" comment="Entity ID"/>
        <column xsi:type="int" name="profile_id" nullable="false" unsigned="true" comment="SARP2 Profile ID"/>
        <column xsi:type="int" name="renewal_year" nullable="false" comment="Anniversary Year"/>
        <column xsi:type="timestamp" name="sent_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Sent At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ABBOTT_SARP2_ANNUAL_REMINDER_UNQ">
            <column name="profile_id"/>
            <column name="renewal_year"/>
        </constraint>
        <index referenceId="ABBOTT_SARP2_ANNUAL_REMINDER_PROFILE_ID">
            <column name="profile_id"/>
        </index>
    </table>
</schema>
