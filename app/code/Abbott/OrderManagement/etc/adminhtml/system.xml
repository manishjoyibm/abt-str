<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
    	<section id="cancel_order_setting" translate="label" sortOrder="300" showInDefault="1" showInWebsite="1" showInStore="1">
    	    <label>Cancel Order</label>
    	    <tab>abbott</tab>
    	    <resource>Abbott_OrderManagement::configuration</resource>
    	    <group id="general" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
        		<label>Cancel Order Configuration</label>
        		<field id="module_enable" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
        		    <label>Status Module</label>
        		    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
        		    <comment>If enable, Cancel Order option will be visible on "Recent Orders, My Orders and on Order details" section.</comment>
        		</field>
        		<field id="cancel_buffer_time" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
        		    <label>Cancel Buffer Time</label>
        		    <depends>
                  <field id="module_enable">1</field>
                </depends>
        		</field>
    	    </group>
            <group id="order_cancel_email" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cancel Order Configuration Email</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cancel order Email</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                    <comment>If enable, cancel order email is sent.</comment>
                </field>
                <field id="cancel_template" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Cancel order Email template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                </field>
            </group>    
            <group id="cancel_order" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cancel Order Settings</label>

                <!-- 1) Enable/Disable Cancel Button -->
                <field id="enabled" translate="label,comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Cancel Button</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                    <comment>If enabled, Cancel button may be shown depending on the allowed statuses below.</comment>
                </field>                
                <!-- 2) Custom multiselect using your selective source model -->
                <field id="allowed_statuses" translate="label,comment" type="multiselect"
                       sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allowed Order Statuses</label>
                    <source_model>Abbott\OrderManagement\Model\Config\Source\SelectiveOrderStatus</source_model>
                    <comment>Select the order statuses for which the Cancel button should be shown.</comment>
                </field>

            </group>

    	</section>
        <section id="sales">
            <group id="identity">
                <field id="sports_address" translate="label" type="textarea" sortOrder="240" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sports Group Address</label>
                </field>
                <field id="address_note" translate="label" type="textarea" sortOrder="250" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Address Note</label>
                </field>
            </group>
        </section>
        <section id="enable_amasty_indexer_setting" translate="label" sortOrder="300" showInDefault="1">
    	    <label>Amasty Grid Reindex</label>
    	    <tab>abbott</tab>
    	    <resource>Abbott_OrderManagement::configuration</resource>
    	    <group id="general" translate="label" type="text" sortOrder="1" showInDefault="1">
                <field id="enable_amasty_indexer" translate="label" type="select" sortOrder="60" showInDefault="1">
                    <label>Enable amasty_order_attribute_grid Indexer</label>
                    <comment>Functionality Enable/Disable for reindex amasty_order_attribute_grid</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
    	    </group>
    	</section>
    </system>
</config>