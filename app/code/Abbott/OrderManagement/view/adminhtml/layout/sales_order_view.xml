<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Abbott_OrderManagement::css/orderform.css"/>
    </head>
    <body>
        <referenceContainer name="left">
            <referenceBlock name="sales_order_tabs">
                <referenceBlock name="order_tab_info">
                    <block class="Magento\Sales\Block\Adminhtml\Order\View\History" name="order_history" template="Abbott_OrderManagement::order/view/history.phtml"/>
                    <referenceBlock name="gift_options" remove="true"/>
                </referenceBlock>
            </referenceBlock>
        </referenceContainer>
    </body>
</page>
