<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">abbott_glucernaorders_managesubscription_form.managesubscription_form_data_source</item>
		</item>
		<item name="label" translate="true" xsi:type="string">GLUCERNA SUBSCRIPTION PLAN</item>
		<item name="template" xsi:type="string">templates/form/collapsible</item>
	</argument>
	<settings>
		<buttons>
			<button class="Abbott\GlucernaOrders\Block\Adminhtml\Managesubscription\Edit\BackButton" name="back"/>
			<button class="Abbott\GlucernaOrders\Block\Adminhtml\Managesubscription\Edit\ResetButton" name="reset"/>
			<button class="Abbott\GlucernaOrders\Block\Adminhtml\Managesubscription\Edit\SaveButton" name="save"/>
			<button class="Abbott\GlucernaOrders\Block\Adminhtml\Managesubscription\Edit\SaveAndContinueButton" name="save_and_continue"/>
		</buttons>
		<namespace>abbott_glucernaorders_managesubscription_form</namespace>
		<dataScope>data</dataScope>
		<deps>
			<dep>abbott_glucernaorders_managesubscription_form.managesubscription_form_data_source</dep>
		</deps>
	</settings>
	<dataSource name="managesubscription_form_data_source">
		<argument name="data" xsi:type="array">
			<item name="js_config" xsi:type="array">
				<item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
			</item>
		</argument>
		<settings>
			<submitUrl path="*/*/save"/>
		</settings>
		<dataProvider class="Abbott\GlucernaOrders\Model\Managesubscription\DataProvider" name="managesubscription_form_data_source">
			<settings>
				<requestFieldName>managesubscription_id</requestFieldName>
				<primaryFieldName>managesubscription_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<fieldset name="general">
		<settings>
			<label>Plan Information</label>
		</settings>
		<field formElement="input" name="plan_code" sortOrder="10">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">managesubscription</item>
					<item name="notice" xsi:type="string" translate="true">Plan Code must be same for actual and trial plan,(all small letters without space and special characters)</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Plan Code</label>
				<dataScope>plan_code</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">true</rule>
				</validation>
			</settings>
		</field>
		<field formElement="input" name="plan_name" sortOrder="20">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">managesubscription</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Plan Name</label>
				<dataScope>plan_name</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="input" name="plan_label" sortOrder="30">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">managesubscription</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Plan Label</label>
				<dataScope>plan_label</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="input" name="trial_period" sortOrder="40">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">managesubscription</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Trial Period</label>
				<dataScope>trial_period</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="input" name="plan_value" sortOrder="50">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">managesubscription</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Plan Value</label>
				<dataScope>plan_value</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">true</rule>
				</validation>
			</settings>
		</field>
		<field formElement="input" name="plan_price" sortOrder="60">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">managesubscription</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Plan Price</label>
				<dataScope>plan_price</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="input" name="plan_shipping_rate" sortOrder="70">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">managesubscription</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Plan Shipping Rate</label>
				<dataScope>plan_shipping_rate</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="select" name="is_trial_plan" sortOrder="80">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">managesubscription</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Is Trial Plan</label>
				<dataScope>is_trial_plan</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
			<formElements>
        <select>
          <settings>
            <options class="Magento\Config\Model\Config\Source\Yesno"/>
          </settings>
        </select>
      </formElements>
		</field>
		<field formElement="select" name="is_default_plan" sortOrder="90">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">managesubscription</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Is Default Plan</label>
				<dataScope>is_default_plan</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
			<formElements>
        <select>
          <settings>
            <options class="Magento\Config\Model\Config\Source\Yesno"/>
          </settings>
        </select>
      </formElements>
		</field>
		<field formElement="select" name="is_active_plan" sortOrder="100">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">managesubscription</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Is Active Plan</label>
				<dataScope>is_active_plan</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
			<formElements>
        <select>
          <settings>
            <options class="Magento\Config\Model\Config\Source\Yesno"/>
          </settings>
        </select>
      </formElements>
		</field>
	</fieldset>
</form>
