			<arguments>
					<argument name="handlers" xsi:type="array">
							<item name="debug" xsi:type="object">Abbott\Hartehanks\Model\Method\VirtualDebug</item>
					</argument>
			</arguments>
	</virtualType>
	<type name="Abbott\Hartehanks\Model\Method\Logger">
			<arguments>
					<argument name="logger" xsi:type="object">Abbott\Hartehanks\Model\Method\VirtualLogger</argument>
