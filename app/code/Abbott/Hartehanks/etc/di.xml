	<type name="Abbott\Hartehanks\Model\ResourceModel\HarteHank\Grid\Collection">
			<arguments>
					<argument name="mainTable" xsi:type="string">apollo_hartehank_log</argument>
					<argument name="eventPrefix" xsi:type="string">abbott_hartehanklog_collection</argument>
					<argument name="eventObject" xsi:type="string">hartehanklog_collection</argument>
					<argument name="resourceModel" xsi:type="string">Abbott\Hartehanks\Model\ResourceModel\HarteHank</argument>
			</arguments>
	</type>
	<type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
		<arguments>
			<argument name="collections" xsi:type="array">
				<item name="abbott_hartehanks_hartehank_listing_data_source" xsi:type="string">Abbott\Hartehanks\Model\ResourceModel\HarteHank\Grid\Collection</item>
				<item name="abbott_hartehanks_hhplaceorder_listing_data_source" xsi:type="string">Abbott\Hartehanks\Model\ResourceModel\HhPlaceOrder\Grid\Collection</item>
			</argument>
		</arguments>
	</type>
	<type name="Abbott\Hartehanks\Model\ResourceModel\HhPlaceOrder\Grid\Collection">
			<arguments>
					<argument name="mainTable" xsi:type="string">apollo_hartehank_placeorder_log</argument>
					<argument name="eventPrefix" xsi:type="string">abbott_hhPlaceOrderlog_collection</argument>
					<argument name="eventObject" xsi:type="string">hartehanklog_collection</argument>
					<argument name="resourceModel" xsi:type="string">Abbott\Hartehanks\Model\ResourceModel\HhPlaceOrder</argument>
			</arguments>
	</type>
