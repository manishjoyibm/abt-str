<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">abbott_progressivediscount_managediscountcodes_form.managediscountcodes_form_data_source</item>
		</item>
		<item name="label" translate="true" xsi:type="string">General Information</item>
		<item name="template" xsi:type="string">templates/form/collapsible</item>
	</argument>
	<settings>
		<buttons>
			<button class="Abbott\ProgressiveDiscount\Block\Adminhtml\ManageDiscountCodes\Edit\BackButton" name="back"/>
			<button class="Abbott\ProgressiveDiscount\Block\Adminhtml\ManageDiscountCodes\Edit\DeleteButton" name="delete"/>
			<button class="Abbott\ProgressiveDiscount\Block\Adminhtml\ManageDiscountCodes\Edit\SaveButton" name="save"/>
			<button class="Abbott\ProgressiveDiscount\Block\Adminhtml\ManageDiscountCodes\Edit\SaveAndContinueButton" name="save_and_continue"/>
		</buttons>
		<namespace>abbott_progressivediscount_managediscountcodes_form</namespace>
		<dataScope>data</dataScope>
		<deps>
			<dep>abbott_progressivediscount_managediscountcodes_form.managediscountcodes_form_data_source</dep>
		</deps>
	</settings>
	<dataSource name="managediscountcodes_form_data_source">
		<argument name="data" xsi:type="array">
			<item name="js_config" xsi:type="array">
				<item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
			</item>
		</argument>
		<settings>
			<submitUrl path="*/*/save"/>
		</settings>
		<dataProvider class="Abbott\ProgressiveDiscount\Model\ManageDiscountCodes\DataProvider" name="managediscountcodes_form_data_source">
			<settings>
				<requestFieldName>row_id</requestFieldName>
				<primaryFieldName>row_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<fieldset name="general">
		<settings>
			<label>Discount Code Information</label>
		</settings>
		<field formElement="input" name="months" sortOrder="20">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">ManageDiscountCodes</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Months</label>
				<dataScope>months</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="textarea" name="discount" sortOrder="30">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">ManageDiscountCodes</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Discount</label>
				<dataScope>discount</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="textarea" name="promotional_sku" sortOrder="40">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">ManageDiscountCodes</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Promotional Product Sku</label>
				<dataScope>promotional_sku</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="textarea" name="plan" sortOrder="40">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">ManageDiscountCodes</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Plan</label>
				<dataScope>plan</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
	</fieldset>
</form>
