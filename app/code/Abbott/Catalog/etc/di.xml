<?xml version="1.0" encoding="UTF-8"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Abbott\SmileSearch\Rewrite\Magento\CatalogGraphQl\Model\Resolver\Products">
        <plugin name="abbott_search_sort_order_plugin" type="Abbott\Catalog\Plugin\Rewrite\Magento\CatalogGraphQl\Model\Resolver\ProductsPlugin"/>
    </type>

    <type name="Abbott\AdditionalAttributes\Model\Resolver\Product\Qty">
        <plugin name="abbott_search_sort_order_plugin" type="Abbott\Catalog\Plugin\AdditionalAttributes\Model\Resolver\QtyPlugin"/>
    </type>

    <type name="Magento\CatalogGraphQl\Model\Resolver\Products\DataProvider\ProductSearch">
        <plugin name="abbott_search_add_field_plugin" type="Abbott\Catalog\Plugin\CatalogGraphQl\Model\Resolver\Products\DataProvider\ProductSearchPlugin"/>
    </type>

    <type name="Abbott\PriceInvGql\Model\Resolver\PriceInvGql">
        <plugin name="abbott_price_inv_gql_price_update" type="Abbott\Catalog\Plugin\PriceInvGql\Model\Resolver\PriceInvGqlPlugin"/>
    </type>

    <type name="Magento\Catalog\Model\Product">
        <plugin name="abbott_rewrite_is_salable" type="Abbott\Catalog\Plugin\Catalog\Model\ProductPlugin"/>
    </type>

    <preference for="Magento\Catalog\Model\ResourceModel\Product\Indexer\Eav\Source" type="Abbott\Catalog\Model\ResourceModel\Product\Indexer\Eav\Source" />

</config>
