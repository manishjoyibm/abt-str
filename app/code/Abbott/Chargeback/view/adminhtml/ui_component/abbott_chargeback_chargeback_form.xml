<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">abbott_chargeback_chargeback_form.chargeback_form_data_source</item>
        </item>
        <item name="label" translate="true" xsi:type="string">General Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button class="Abbott\Chargeback\Block\Adminhtml\Chargeback\Edit\BackButton" name="back"/>
            <button class="Abbott\Chargeback\Block\Adminhtml\Chargeback\Edit\SftpSync" name="sftp"/>
            <button class="Abbott\Chargeback\Block\Adminhtml\Chargeback\Edit\SaveButton" name="save"/>
        </buttons>
        <namespace>abbott_chargeback_chargeback_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>abbott_chargeback_chargeback_form.chargeback_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="chargeback_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="Abbott\Chargeback\Model\Chargeback\DataProvider" name="chargeback_form_data_source">
            <settings>
                <requestFieldName>chargeback_id</requestFieldName>
                <primaryFieldName>chargeback_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label/>
        </settings>
        <field name="chargeback_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">Chargeback</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>chargeback_id</dataScope>
            </settings>
        </field>
        <field name="file_name">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">Chargeback</item>
                    <item name="label" xsi:type="string" translate="true">File</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="formElement" xsi:type="string">fileUploader</item>
                    <item name="elementTmpl" xsi:type="string">ui/form/element/uploader/uploader</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                    <item name="uploaderConfig" xsi:type="array">
                        <item name="url" xsi:type="url" path="abbott_chargeback/chargeback/upload"/>
                    </item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>
