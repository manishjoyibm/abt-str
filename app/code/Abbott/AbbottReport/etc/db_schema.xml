<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="aggregated_product_subscription">
        <column xsi:type="int" name="id" padding="10" unsigned="true" identity="true" nullable="false" comment="Id"/>
        <column xsi:type="datetime" name="period" nullable="true" comment="Period"/>
        <column xsi:type="int" name="store_id" padding="10" unsigned="true" nullable="false" comment="Store Id"/>
        <column xsi:type="int" name="product_id" nullable="true" padding="10" comment="Product Id"/>
        <column xsi:type="text" name="product_name" nullable="true" comment="Product Name"/>
        <column xsi:type="int" name="subscriber_count" nullable="true" padding="10" comment="Subscriber Count"/>
        <column xsi:type="int" name="active_subscriber" padding="10" nullable="false" comment="Active Subscriber"/>
        <column xsi:type="int" name="suspended_subscriber" nullable="true" padding="10" comment="Suspended Subscriber"/>
        <column xsi:type="int" name="cancel_subscriber" nullable="true" padding="10" comment="Cancel Subscriber"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>
    <table name="aggregated_customer_subscription">
        <column xsi:type="int" name="id" padding="10" unsigned="true" identity="true" nullable="false" comment="Id"/>
        <column xsi:type="datetime" name="period" nullable="true" comment="Period"/>
        <column xsi:type="int" name="store_id" padding="10" unsigned="true" nullable="false" comment="Store Id"/>
        <column xsi:type="int" name="customer_id" nullable="true" padding="10" comment="Customer Id"/>
        <column xsi:type="text" name="customer_name" nullable="true" comment="Customer Name"/>
        <column xsi:type="text" name="customer_email" nullable="true" comment="Customer Email"/>
        <column xsi:type="int" name="subscriber_count" nullable="true" padding="10" comment="Subscriber Count"/>
        <column xsi:type="int" name="active_subscriber" padding="10" nullable="false" comment="Active Subscriber"/>
        <column xsi:type="int" name="suspended_subscriber" nullable="true" padding="10" comment="Suspended Subscriber"/>
        <column xsi:type="int" name="cancel_subscriber" nullable="true" padding="10" comment="Cancel Subscriber"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>
    <table name="sales_shipment_item">
      <index referenceId="INDEX_ORDER_ITEM_ID" indexType="btree">
           <column name="order_item_id"/>
      </index>
    </table>
</schema>
