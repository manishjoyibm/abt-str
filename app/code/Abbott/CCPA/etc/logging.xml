<logging xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Logging:etc/logging.xsd">
    <groups>
        <group name="Abbott_CCPA">
            <label translate="true">CCPA Deactive User</label>
            <expected_models>
                <expected_model class="Magento\Customer\Model\Customer">
                    <skip_fields>
                        <field name="email" />
                    </skip_fields>
                </expected_model>
            </expected_models>
            <events>
                <event controller_action="ccpa_index_index" action_alias="save">
                    <skip_on_back>
                            <controller_action name="customer_index_edit" />
                    </skip_on_back>
                </event>
            </events>
        </group>
    </groups>
</logging>
