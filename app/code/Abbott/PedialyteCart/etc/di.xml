<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Abbott\PedialyteCart\Logger\Method\System" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/pedialyte_cart_report.log</argument>
        </arguments>
    </virtualType>
    <type name="Abbott\PedialyteCart\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">Pedialyte_Log</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Abbott\PedialyteCart\Logger\Method\System</item>
            </argument>
        </arguments>
    </type>
</config>
