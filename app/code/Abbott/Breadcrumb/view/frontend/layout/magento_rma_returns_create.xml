<?xml version="1.0" encoding="UTF-8"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="breadcrumbs_account"/>
    <body>
        <referenceBlock name="breadcrumbs">
        <action method="setTemplate" ifconfig="my_account/breadcrumbs/breadcrumbs_enabled">
                <argument name="template" xsi:type="string">Abbott_Breadcrumb::html/breadcrumbs.phtml</argument>
            </action>
             <action method="addCrumb" ifconfig="my_account/breadcrumbs/breadcrumbs_enabled">
                <argument name="crumbName" xsi:type="string">account.return.list</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string" translate="true">My Returns</item>
                    <item name="label" xsi:type="string" translate="true">My Returns</item>
                    <item name="link" xsi:type="string">{{baseUrl}}rma/returns/history</item>
                </argument>
            </action>
            <action method="addCrumb" ifconfig="my_account/breadcrumbs/breadcrumbs_enabled">
                <argument name="crumbName" xsi:type="string">account.return.edit</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string" translate="true">Return Information</item>
                    <item name="label" xsi:type="string" translate="true">Return Information</item>
                    <item name="last" xsi:type="boolean">true</item>
                </argument>
            </action>
        </referenceBlock>
    </body>
</page>
