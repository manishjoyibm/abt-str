<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/sendAndSaveOtp" method="POST">
        <service class="Abbott\CustomerTwoFactorAuth\Api\OtpManagerInterface" method="sendAndSaveOtp" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/verifyOtp" method="POST">
        <service class="Abbott\CustomerTwoFactorAuth\Api\OtpManagerInterface" method="verifyOtp" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/customerTwoFa" method="POST">
        <service class="Abbott\CustomerTwoFactorAuth\Api\OtpManagerInterface" method="getCustomerAttribute" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
</routes>
