<?xml version="1.0" ?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="metabolic_ordering" resource="default" engine="innodb"
           comment="Metabolic Ordering Table">
    <column xsi:type="int" name="entity_id" unsigned="false" nullable="false" identity="true" comment="Entity ID"/>
    <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" identity="false" comment="Customer ID"/>
    <column xsi:type="varchar" name="customer_email" nullable="false" length="255" comment="Customer Email"/>
    <column xsi:type="varchar" name="sku" nullable="false" length="255" comment="Sku"/>
    <column xsi:type="varchar" name="admin_user" nullable="false" length="255" comment="Admin User"/>
    <column xsi:type="int" name="qty" unsigned="true" nullable="false" identity="false" comment="Qty"/>
    <column xsi:type="smallint" name="enable_email" default="1" unsigned="true" nullable="false" identity="false" comment="Enable Email"/>
    <column xsi:type="smallint" name="disable_email" default="0" unsigned="true" nullable="false" identity="false" disabled="true" comment="Disable Email"/>
    <column name="created_at" comment="Created At" default="CURRENT_TIMESTAMP" nullable="false" xsi:type="timestamp"/>
    <column name="updated_at" comment="Updated At" default="CURRENT_TIMESTAMP" nullable="false" xsi:type="timestamp"/>
    <column name="expiry_date" comment="Expiry Date" nullable="false" xsi:type="date"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
        <column name="entity_id"/>
    </constraint>
    <constraint xsi:type="unique" referenceId="CATALOG_PRODUCT_ENTITY_DATETIME_ENTITY_ID_ATTRIBUTE_ID_STORE_ID">
        <column name="customer_id"/>
        <column name="sku"/>
    </constraint>
    <index referenceId="METABOLIC_ORDERING_CUSTOMER_ID" indexType="btree">
        <column name="customer_id"/>
    </index>
    <index referenceId="METABOLIC_ORDERING_SKU" indexType="btree">
        <column name="sku"/>
    </index>
    <index referenceId="METABOLIC_ORDERING_CREATED_AT" indexType="btree">
        <column name="created_at"/>
    </index>
</table>
</schema>
