<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Abbott_AdminSessionAlert::css/session-alert.css" />
    </head>
    <body>
        <referenceContainer name="after.body.start">
            <block name="session.alert" template="Abbott_AdminSessionAlert::timeout.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Abbott\AdminSessionAlert\ViewModel\SessionConfiguration</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
