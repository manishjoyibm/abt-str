<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="apollo_targetbase">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" identity="true" nullable="false" comment="Entity Id"/>
        <column xsi:type="int" name="store_id" padding="10" unsigned="true" nullable="false" comment="Store Id"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer Id"/>
        <column xsi:type="int" name="contact_preference" nullable="true" padding="10" comment="Contact Preference"/>
        <column xsi:type="int" name="is_registration" nullable="true" padding="10" comment="is_registration"/>
        <column xsi:type="int" name="is_address_change" nullable="true" padding="10" comment="Is Address Changed"/>
        <column xsi:type="int" name="order_id" padding="10" nullable="false" comment="Order Id"/>
        <column xsi:type="varchar" name="status" nullable="false" length="10" comment="Status"/>
        <column xsi:type="timestamp" name="created_at"  comment="Created At" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="APOLLO_TARGETBASE_ENTITY_ID" indexType="btree">
            <column name="entity_id"/>
        </index>
        <index referenceId="APOLLO_TARGETBASE_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="APOLLO_TARGETBASE_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
        <index referenceId="APOLLO_TARGETBASE_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>

    <table name="apollo_targetbase_order">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" identity="true" nullable="false" comment="Entity Id"/>
        <column xsi:type="int" name="store_id" padding="10" unsigned="true" nullable="false" comment="Store Id"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer Id"/>
        <column xsi:type="int" name="order_type" padding="10" unsigned="true" nullable="false" comment="Customer Id"/>
        <column xsi:type="varchar" name="order_id" nullable="false" length="64" comment="Order Id"/>
        <column xsi:type="timestamp" name="created_at"  comment="Created At"/>
        <column xsi:type="varchar" name="coupon_code" nullable="true" length="64" comment="Coupon Code"/>
        <column xsi:type="varchar" name="payment_method" nullable="false" length="64" comment="Shipping Method"/>
        <column xsi:type="float" name="tax_amount" unsigned="true" nullable="false" comment="Tax Amount"/>
        <column xsi:type="float" name="shipping_amount" unsigned="true" nullable="false" comment="Shipping Amount"/>
        <column xsi:type="float" name="grand_total" unsigned="true" nullable="false" comment="Grand Total Amount"/>
        <column xsi:type="varchar" name="product_brand" nullable="false" length="128" comment="Product Brand"/>
        <column xsi:type="varchar" name="product_sku" nullable="false" length="64" comment="Product Sku"/>
        <column xsi:type="varchar" name="product_name" nullable="false" length="128" comment="Product Name"/>
        <column xsi:type="int" name="product_qty_ordered" padding="10" unsigned="true" nullable="false" comment="Qty Ordered"/>
        <column xsi:type="float" name="product_price" unsigned="true" nullable="false" comment="Product Price"/>
        <column xsi:type="boolean" name="is_complete" nullable="false" default="false" comment="Is Complete?"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
         <index referenceId="APOLLO_TARGETBASE_ORDER_ENTITY_ID" indexType="btree">
            <column name="entity_id"/>
        </index>
        <index referenceId="APOLLO_TARGETBASE_ORDER_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="APOLLO_TARGETBASE_ORDER_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
        <index referenceId="APOLLO_TARGETBASE_ORDER_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
