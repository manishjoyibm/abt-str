<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="targetbase_filecreate_cron" instance="Abbott\Targetbase\Model\TargetbaseFileCreation" method="execute">
            <config_path>targetbase_integration/targetbase/targetbase_filecreate_expr</config_path>
        </job>
        <job name="targetbase_filesync_cron" instance="Abbott\Targetbase\Model\TargetbaseFileSync" method="execute">
            <config_path>targetbase_integration/targetbase/targetbase_filesync_expr</config_path>
        </job>
    </group>
</config>
