<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="abbott" translate="label" sortOrder="1">
            <label>Abbott</label>
        </tab>
        <section id="global_optout_settings" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
            <class>separator-top</class>
            <tab>abbott</tab>
            <label>Global Opt Out Integration</label>
            <resource>Abbott_GlobalOptOut::globaloptout_integration</resource>
            <group id="global_optout_sftp" showInDefault="1">
                <label>SFTP Settings</label>
                <field id="host" showInDefault="1" showInStore="0" showInWebsite="0" sortOrder="14" translate="label" type="text">
                    <label>SFTP Host</label>
                </field>
                <field id="port" showInDefault="1" showInStore="0" showInWebsite="0" sortOrder="15" translate="label" type="text">
                    <label>Port Number</label>
                </field>
                <field id="username" showInDefault="1" showInStore="0" showInWebsite="0" sortOrder="20" translate="label" type="text">
                    <label>User Name</label>
                </field>
                <field id="password" showInDefault="1" showInStore="0" showInWebsite="0" sortOrder="30" translate="label" type="obscure">
                    <label>Password</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>                
            </group>
            
           
            <group id="global_optout_crons" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cron Settings</label>
                <field id="glopt_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Opt-Out Sync</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                </field>
                <field id="sync_expr" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cron Expression for Sync</label>
                    <comment>Ex(*/30 * * * *) Please make sure there is space between each star(*).</comment>
                    <depends>
                        <field id="glopt_enabled">1</field>
                    </depends>
                </field>                 
            </group>
        </section>
    </system>
</config>
