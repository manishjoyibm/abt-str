<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Abbott\DatabaseBackup\Logger\Logger" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/database-backup.log</argument>
        </arguments>
    </virtualType>
    <type name="Abbott\DatabaseBackup\Logger\Method\Logger">
        <arguments>
            <argument name="name" xsi:type="string">DatabaseBackup_Log</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Abbott\DatabaseBackup\Logger\Logger</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="dbdump" xsi:type="object">Abbott\DatabaseBackup\Console\Command\Dbdump</item>
            </argument>
        </arguments>
    </type>
</config>
