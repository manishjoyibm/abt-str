<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <!-- Address-level collect -->
    <event name="sales_quote_address_collect_totals_before">
        <observer name="abbott_apply_adult_signature_on_totals"
                  instance="Abbott\AdultSignature\Observer\ApplyAdultSignatureOnTotals"/>
    </event>

    <!-- Quote-level fallback after collect -->
    <event name="sales_quote_collect_totals_after">
        <observer name="abbott_apply_adult_signature_on_quote"
                  instance="Abbott\AdultSignature\Observer\ApplyAdultSignatureOnTotals"/>
    </event>

    <!-- Copy to order and enforce acceptance -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="abbott_copy_flags_to_order"
                  instance="Abbott\AdultSignature\Observer\CopyFlagsToOrder"/>
    </event>
</config>