+    /**
+     * Fetch order by increment_id with retry logic.
+     *
+     * @param string $incrementId
+     * @param int $maxAttempts
+     * @param int $initialDelayMs
+     * @return OrderInterface|null
+     */
+    public function fetchByIncrementIdWithRetry(
+        string $incrementId,
+        int $maxAttempts = 5,
+        int $initialDelayMs = 100
+    ): ?OrderInterface {
+        $attempt = 1;
+        $delayMs = $initialDelayMs;
+
+        while ($attempt <= $maxAttempts) {
+            $order = $this->tryFetchByIncrementId($incrementId);
+            if ($order) {
+                return $order;
+            }
+
+            $this->logger->info(sprintf(
+                'Order not found for increment_id=%s (attempt %d/%d). Retrying after %dms.',
+                $incrementId,
+                $attempt,
+                $maxAttempts,
+                $delayMs
+            ));
+
+            usleep($delayMs * 1000); // sleep in microseconds
+            $delayMs *= 2; // exponential backoff
+            $attempt++;
+        }
+
+        $this->logger->warning(sprintf(
+            'Order with increment_id=%s not found after %d attempts.',
+            $incrementId,
+            $maxAttempts
+        ));
+
+        return null;
+    }
+
+    /**
+     * Try fetching order once by increment_id.
+     *
+     * @param string $incrementId
+     * @return OrderInterface|null
+     */
+    private function tryFetchByIncrementId(string $incrementId): ?OrderInterface
+    {
+        $collection = $this->orderCollectionFactory->create();
+        $collection->addFieldToFilter('increment_id', $incrementId);
+        $collection->setPageSize(1)->setCurPage(1);
+
+        $entityId = null;
+        foreach ($collection as $orderModel) {
+            $entityId = (int)$orderModel->getId();
+            break;
+        }
+
+        if (!$entityId) {
+            return null;
+        }
+
+        try {
+            return $this->orderRepository->get($entityId);
+        } catch (NoSuchEntityException $e) {
+            return null;
+        }
+    }
 }
